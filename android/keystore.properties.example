# SERTZ 릴리스 서명 정보 — 이 파일은 커밋하지 않는다 (.gitignore: android/keystore.properties)
#
#   cp keystore.properties.example keystore.properties   후 값을 채운다.
#
# CI(GitHub Actions)에서는 이 파일 대신 Secrets 4종을 쓴다:
#   SERTZ_KEYSTORE_BASE64 · SERTZ_KEYSTORE_PASSWORD · SERTZ_KEY_PASSWORD · SERTZ_KEY_ALIAS
#   keystore를 base64로:  base64 -w0 sertz-release.keystore
#
# ⚠ 2026-10 이전 커밋의 키와 비밀번호는 공개 저장소에 노출됐다 — 로테이션 전까지 이 값을 그대로 쓰지 말 것.

storeFile=../sertz-release.keystore
storePassword=CHANGE_ME
keyAlias=sertz
keyPassword=CHANGE_ME
