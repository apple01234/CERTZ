          "anim": "cast_haru-idle-side",
          "x": 1858.9999999999998,
          "y": 681,
          "visible": true
        }
      ]
    },
    {
      "speaker": "도사",
      "lines": [
        "보석의 힘의 흔적이야. 내 힘으로는 닿지 못한다. 하루, 자네가 해야겠어."
      ],
      "actors": [
        {
          "name": "rea:actor:lead",
          "texture": "cast_lucy",
          "frame": "hurt",
          "anim": "cast_lucy-hurt",
          "x": 1832.9999999999998,
